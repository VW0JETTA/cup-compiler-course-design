FUNCTION fact :
PARAM v1
IF v1 == #1 GOTO label1
GOTO label2
LABEL label1 :
RETURN v1
LABEL label2 :
t1 := v1 - #1
ARG t1
t2 := CALL fact
t3 := v1 * t2
RETURN t3
FUNCTION main :
READ v2
IF v2 > #1 GOTO label4
GOTO label5
LABEL label4 :
ARG v2
v3 := CALL fact
GOTO label6
LABEL label5 :
v3 := #1
LABEL label6 :
WRITE v3
RETURN #0
