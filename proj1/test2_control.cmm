/* ============================================================
 * test2_control.cmm — 合法程序：控制流语句
 * 覆盖：while 循环、if、if-else、嵌套 if-else（悬空 else）、
 *       不带花括号的单语句分支
 * 预期：无错误，输出完整语法树
 *       悬空 else 应绑定到最近的未匹配 if
 * ============================================================ */
int main()
{
    int i;
    int n;
    int flag;
    n = 10;
    i = 0;
    flag = 0;

    while (i < n) {
        if (i > 5)
            flag = 1;
        else
            flag = 0;
        i = i + 1;
    }

    if (flag)
        if (n > 0)
            n = n - 1;        /* 此 else 绑定到最近的 if (n > 0) */
        else
            n = 0;

    return n;
}
