/* ============================================================
 * test4_expr.cmm — 合法程序：表达式与运算符
 * 覆盖：运算符优先级与结合性、一元取负/逻辑非、括号表达式、
 *       关系/逻辑运算、赋值右结合、函数调用(带参/无参)
 * 预期：无错误，输出完整语法树
 *       优先级 () [] . > 一元 -/! > * / > + - > 关系 > && > || > =
 * ============================================================ */
int zero()
{
    return 0;
}

int compute(int a, int b)
{
    return a + b * 2 - (a - b) / 2;     /* * / 高于 + -，括号最高 */
}

int main()
{
    int x, y, z;
    int r;
    x = 5;
    y = 3;
    z = -x + !y;                        /* 一元取负、逻辑非 */
    r = x > y && y > 0 || x == 0;       /* 关系 > && > || */
    z = x = y = 10;                     /* 赋值右结合 */
    r = compute(x, y) + zero();         /* 函数调用：带参 + 无参 */
    if (x >= 1 && x <= 100)
        r = r + 1;
    return r;
}
