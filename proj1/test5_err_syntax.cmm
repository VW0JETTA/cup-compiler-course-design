/* ============================================================
 * test5_err_syntax.cmm — 语法错误（Error type B）
 * 三处语法错误之间以合法语句间隔，确保各错误在错误恢复后
 * 都能被独立检测报告（避免 Bison 级联错误的相互抑制）。
 * 预期错误：
 *   Line 16: 数组下标用逗号 arr[1, 2]（应为 arr[1][2]）
 *   Line 21: if 后缺少左括号 (
 *   Line 26: 括号不匹配，缺少右括号 )
 * ============================================================ */
int main()
{
    int a;
    int b;
    int arr[10];

    a = arr[1, 2];        /* 错误1：数组下标应为 arr[1][2] */
    a = 1;
    b = 2;
    b = a + 1;

    if a > 0) a = 1;      /* 错误2：if 后缺少左括号 ( */
    a = 1;
    b = 2;
    b = a + b;

    a = (b + 1 ;          /* 错误3：缺少右括号 ) */
    return 0;
}
