/* ============================================================
 * test6_err_lexical.cmm — 词法错误（Error type A）
 * 非法数字嵌于数值位置：报 A 后以占位 INT 返回，保持语法完整，
 * 因此每处只产生一个 A 类错误，不连带语法错误。
 * 非法字符位于「丢弃后仍合法」的位置，同样只报 A。
 * 预期错误：
 *   Line 13: 非法八进制 09
 *   Line 14: 非法十六进制 0x3G
 *   Line 16: 非法字符 @
 * ============================================================ */
int main()
{
    int a = 09;
    int b = 0x3G;
    int c;
    c = @a;
    return c;
}
